# Supabase project base URL. Use the project root URL, never a /rest/v1/ endpoint.
# Local stack (supabase/config.toml): http://127.0.0.1:54421
# Hosted project: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# Supabase publishable (anon) key. Safe for the browser; protected by RLS.
# Local value: run `npm run db:status` (PUBLISHABLE_KEY, or the legacy ANON_KEY).
# Hosted value: the project's publishable/anon key.
# Never put a service-role or secret key here, and never commit a real .env.local.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of the app. Used for auth email redirects and absolute links.
# Local development: optional; development falls back to http://localhost:3000.
# Vercel Production: required; use the canonical https origin, e.g. https://app.example.com.
# Vercel Preview: optional; when omitted, the deployment uses https://$VERCEL_URL.
# Must be an http(s) origin with no path, query, hash, or credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
